<launch>
    <arg name="image_topic" default="/camera/color/image_raw"/>
    <arg name="range_topic" default="/ouster/range_image"/>
    <arg name="pose_topic" default="/localization"/>
    <arg name="goal_topic" default="/semilocal_goal"/>
    <arg name="state_topic" default="/estimated_ackermann_state"/>
    <arg name="ackermann_cmd_topic" default="/ackermann_cmd"/>
    <arg name="desired_ackermann_topic" default="/desired_ackermann_state"/> <!-- The topic that communicates with clear, in degrees -->
    <arg name="model" default="rgb+depth"/>
    <arg name="inverted_axis" default="true"/>
    <arg name="model_path" default="/home/ubuntu/aurova_ws/src/Sim2Real/model.pth "/>
    
  
  <node pkg="sim2real_local_planner" name="agent_ros" exec="agent_ros" output="screen">
    <remap from="rgb_image"  to="$(var image_topic)"/>
    <remap from="range_image" to="$(var range_topic)"/>
    <remap from="pose" to="$(var pose_topic)"/>
    <remap from="goal"   to="$(var goal_topic)"/>
    <remap from="ackermann_state"   to="$(var state_topic)"/>
    <remap from="ackermann_cmd"   to="$(var ackermann_cmd_topic)"/>
    <remap from="desired_ackermann_state"   to="$(var desired_ackermann_topic)"/>
    <param name="model"   value="$(var model)"/>
    <param name="model_path"   value="$(var model_path)"/>
    <param name="inverted_axis"   value="$(var inverted_axis)"/>
  </node>

</launch>
