# YOLOv5 🚀 by Ultralytics, GPL-3.0 license

# Start FROM Nvidia PyTorch image https://ngc.nvidia.com/catalog/containers/nvidia:pytorch
FROM ros:jazzy

# install ros packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-desktop-full \
    && rm -rf /var/lib/apt/lists/*

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y apt-utils curl wget git bash-completion build-essential sudo && rm -rf /var/lib/apt/lists/*

RUN echo "ubuntu:ubuntu" | chpasswd

# Install pip
RUN apt-get update && apt-get install -y python3-pip && rm -rf /var/lib/apt/lists/*

USER ubuntu
RUN mkdir -p /home/ubuntu/aurova_ws

# Initialize the workspace Delete this before commit
RUN cd /home/ubuntu/aurova_ws && mkdir src

RUN python3 -m pip config set global.break-system-packages true
RUN pip3 install gdown easydict 
RUN pip3 install torch==2.14.1 torchvision==0.29.1 torchaudio==2.11.0 --index-url https://download.pytorch.org/whl/cu126
RUN pip3 install torch_scatter torch_sparse torch_cluster torch_spline_conv -f https://data.pyg.org/whl/torch-2.14.0+cu126
RUN pip3 install pyquaternion
# COPY requirements.txt .
# ENV SKLEARN_ALLOW_DEPRECATED_SKLEARN_PACKAGE_INSTALL True
# RUN pip install --no-cache -r requirements.txt

# ROS installlation
USER root
RUN apt-get update && apt install -y python-is-python3
RUN apt-get install -y libsm6 libxrender1 libfontconfig1 libglib2.0-0
RUN apt-get install -y ros-${ROS_DISTRO}-rmw-cyclonedds-cpp
RUN apt-get install -y ros-${ROS_DISTRO}-ackermann-msgs && \
    rm -rf /var/lib/apt/lists/*
RUN cd /home/ubuntu/aurova_ws/src && mkdir Sim2Real

RUN cd /home/ubuntu/aurova_ws/src/Sim2Real/ && mkdir resource && touch resource/sim2real_local_planner
COPY setup* package.xml /home/ubuntu/aurova_ws/src/Sim2Real/
COPY sim2real_local_planner/ /home/ubuntu/aurova_ws/src/Sim2Real/sim2real_local_planner/
COPY launch/ /home/ubuntu/aurova_ws/src/Sim2Real/launch/
RUN cd /home/ubuntu/aurova_ws/src/Sim2Real/ && chmod +x sim2real_local_planner/agent_ros.py

USER ubuntu

ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
## Compile the package
RUN cd /home/ubuntu/aurova_ws/ && colcon build
CMD  /bin/bash -c "source /home/ubuntu/aurova_ws/install/setup.bash && ros2 launch sim2real_local_planner agent_ros.xml"